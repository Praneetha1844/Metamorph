# Copy to .env.local. Vite exposes VITE_* variables to the browser, so never use a production secret here.

# Optional: remote execution for Python / C++ / Java via Judge0 (RapidAPI)
VITE_JUDGE0_KEY=your-rapidapi-key
# VITE_JUDGE0_URL=https://judge0-ce.p.rapidapi.com

# Optional: local Ollama server used for refactor suggestions
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=codellama

# Optional: Metamorph engine (Python backend) used for test-verified refactors
# VITE_ENGINE_URL=http://127.0.0.1:8000
