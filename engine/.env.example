# Copy to .env and export, or pass through docker compose. No secrets belong in the repository.

# Provider: "ollama" (default) or "openai" (any OpenAI-compatible chat endpoint)
METAMORPH_PROVIDER=ollama

METAMORPH_OLLAMA_URL=http://localhost:11434
METAMORPH_OLLAMA_MODEL=codellama

# Only needed when METAMORPH_PROVIDER=openai
# METAMORPH_OPENAI_BASE_URL=https://api.openai.com/v1
# METAMORPH_OPENAI_API_KEY=
# METAMORPH_OPENAI_MODEL=

# Verification loop
METAMORPH_MAX_ATTEMPTS=3
METAMORPH_TEST_TIMEOUT_S=10
METAMORPH_MEMORY_MB=512

# Sandbox: "subprocess" (default) or "docker"
METAMORPH_SANDBOX=subprocess
METAMORPH_DOCKER_IMAGE=metamorph-sandbox:latest

# Comma-separated browser origins allowed to call the API
METAMORPH_CORS_ORIGINS=http://localhost:5173
